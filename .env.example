# Copy to .env and fill in.

# --- Required ----------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# --- Optional ----------------------------------------------------------
# Model used to draft replies. Haiku is fast & cheap; Sonnet is sharper.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Name used to sign off replies.
USER_SIGNOFF=Jie

# Override default config locations (~/.config/mail-triage/...)
# MAIL_TRIAGE_CONFIG_DIR=/Users/jie/.config/mail-triage
# GMAIL_CREDENTIALS_PATH=/path/to/credentials.json
# GMAIL_TOKEN_PATH=/path/to/token.json
