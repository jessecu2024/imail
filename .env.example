# Copy to .env and fill in.

# --- Required ----------------------------------------------------------
# Get one at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-...

# --- Optional ----------------------------------------------------------
# Override the LLM endpoint. Default is DeepSeek; any OpenAI-compatible
# host works (Together, Groq, Moonshot, 302.AI, etc.).
# IMAIL_BASE_URL=https://api.deepseek.com

# Model used to draft replies.
#   deepseek-chat       — fast & cheap (V3); the default
#   deepseek-reasoner   — sharper, uses CoT (R1); slower / pricier
IMAIL_MODEL=deepseek-chat

# Name used to sign off replies.
USER_SIGNOFF=Jie

# Local server bind. Default 127.0.0.1:8765.
# IMAIL_HOST=127.0.0.1
# IMAIL_PORT=8765

# Override default config locations (~/.config/imail/...)
# IMAIL_CONFIG_DIR=/Users/jie/.config/imail
# GMAIL_CREDENTIALS_PATH=/path/to/credentials.json
